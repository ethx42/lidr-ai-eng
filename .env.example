# Provider: openai | anthropic
LLM_PROVIDER=openai
# Server-side model id (e.g. gpt-4o-mini, claude-haiku-4-5)
LLM_MODEL=gpt-4o-mini
# Key for the selected provider is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

APP_ENV=development
LOG_LEVEL=DEBUG

# Tunables (defaults shown)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
# Applied only to models that support sampling parameters
LLM_TEMPERATURE=0.2
# low | medium | high; applied only to reasoning models (unset by default)
LLM_REASONING_EFFORT=
MAX_TRANSCRIPTION_CHARS=50000
# Optional; enables cost estimation
BLENDED_HOURLY_RATE=
WEEKLY_CAPACITY_HOURS=30
