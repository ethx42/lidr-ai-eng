# Provider: openai | anthropic | replay (offline, no key; see Replay below)
LLM_PROVIDER=openai
# Server-side model id (e.g. gpt-4o-mini, claude-haiku-4-5)
LLM_MODEL=gpt-4o-mini
# Every provider in the chain (LLM_PROVIDER and LLM_FALLBACKS) needs its key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Prompt template version: a directory under app/prompts/estimation/ (v1, v2, ...). An unknown
# version fails startup.
PROMPT_VERSION=v2

# Fallback chain after the primary: comma-separated provider:model, tried in order when the
# provider is down, rate limited or out of quota (and, when streaming, before the first token).
# `none` disables fallback; an empty value is ignored and keeps this default.
# Only the last provider in the chain uses LLM_MAX_RETRIES; the ones before it get no SDK
# retries, because the next provider is their retry.
LLM_FALLBACKS=anthropic:claude-haiku-4-5
# Skip a provider for LLM_COOLDOWN_SECONDS after LLM_COOLDOWN_FAILURES consecutive failures
LLM_COOLDOWN_FAILURES=3
LLM_COOLDOWN_SECONDS=30

# Exact-match response cache (e.g. redis://localhost:6379/0); unset disables it. Redis being down or
# slow never fails a request: each cache read or write is cut off after 0.2 s (so Redis adds at most
# ~0.4 s to a request), and a failed read counts as a miss. Docker Compose overrides it with its own
# Redis service.
REDIS_URL=
CACHE_TTL_SECONDS=86400

# Replay (LLM_PROVIDER=replay): replays the recorded cassette matching the prompt pair, or synthesises
# a stream when none does. The default fallback still needs its key, so offline runs also set
# LLM_FALLBACKS=none. Delay scale: 0 replays instantly, 1 at the recorded pace.
REPLAY_CASSETTE_DIR=tests/cassettes
REPLAY_DELAY_SCALE=1

APP_ENV=development
LOG_LEVEL=DEBUG

# Tunables (defaults shown)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
# Applied only to models that support sampling parameters
LLM_TEMPERATURE=0.2
# none | minimal | low | medium | high | xhigh | max; sent only to reasoning models that support the level (unset by default)
LLM_REASONING_EFFORT=
MAX_TRANSCRIPTION_CHARS=50000
# Optional; enables cost estimation
BLENDED_HOURLY_RATE=
WEEKLY_CAPACITY_HOURS=30

# Spend cap in USD for the live make targets (smoke-live, record-cassettes, eval), checked against
# docs/catch-up/spend.jsonl. Read from the process environment, not by the app: export it or prefix
# the command (LIVE_BUDGET_USD=2 make smoke-live).
# LIVE_BUDGET_USD=5

# Host names (no port) the API answers; anything else gets 400 (DNS rebinding guard).
# ALLOWED_HOSTS=localhost,127.0.0.1,ai-service,testserver
