  "info": {
    "description": "Turns a meeting transcription into a software estimation using Cache-Augmented Generation:\nreference estimations travel inside a cache-stable system prompt, the LLM returns a structured\nbreakdown, and totals, grounding checks, and the markdown report are computed in code.\n",
    "title": "CAG Software Estimator",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/context": {
      "get": {
        "description": "The system prompt is rendered for the given enums (defaults: `web_saas`, `medium`, `phases_table`) and prompt version (default: the `PROMPT_VERSION` setting).",
        "operationId": "context_api_v1_context_get",
        "parameters": [
          {
            "in": "query",
            "name": "project_type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ProjectType",
              "default": "web_saas"
            }
          },
          {
            "in": "query",
            "name": "detail_level",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DetailLevel",
              "default": "medium"
            }
          },
          {
            "in": "query",
            "name": "output_format",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OutputFormat",
              "default": "phases_table"
            }
          },
          {
            "description": "Prompt template version (`v1`, `v2`, \u2026); default: `PROMPT_VERSION`.",
            "in": "query",
            "name": "prompt_version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
